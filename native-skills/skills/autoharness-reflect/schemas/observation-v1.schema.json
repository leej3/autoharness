{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoHarness hook observation v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "number"
        },
        "measurement": {
          "enum": [
            "host-observed",
            "agent-reported"
          ]
        },
        "kind": {
          "const": "turn"
        },
        "event": {
          "enum": [
            "Stop",
            "Interrupt"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duration_scope": {
          "const": "turn"
        },
        "tool_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "skill_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "const": "unknown"
        }
      },
      "required": [
        "schema_version",
        "id",
        "recorded_at",
        "measurement",
        "kind",
        "event",
        "duration_seconds",
        "duration_scope",
        "tool_counts",
        "skill_candidates",
        "model",
        "outcome"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "number"
        },
        "measurement": {
          "enum": [
            "host-observed",
            "agent-reported"
          ]
        },
        "kind": {
          "const": "usage-report"
        },
        "usages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill",
              "purpose",
              "outcome",
              "reflection"
            ],
            "properties": {
              "skill": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"
              },
              "purpose": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"
              },
              "outcome": {
                "enum": [
                  "success",
                  "partial",
                  "failure",
                  "abandoned",
                  "unknown"
                ]
              },
              "reflection": {
                "enum": [
                  "none",
                  "needed",
                  "unknown"
                ]
              },
              "skill_duration_seconds": {
                "type": "number",
                "minimum": 0
              },
              "friction": {
                "enum": [
                  "none",
                  "instructions",
                  "tooling",
                  "missing-context",
                  "other"
                ]
              },
              "correction_count": {
                "type": "integer",
                "minimum": 0
              },
              "feedback_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "recorded_at",
        "measurement",
        "kind",
        "usages"
      ]
    }
  ]
}
